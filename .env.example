# Copy this file to .env and fill in real values. Never commit .env.

# --- SMTP / email alerts ---
# Example for Gmail: use an "App Password", not your real account password.
# https://support.google.com/accounts/answer/185833
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password-here
ALERT_FROM_EMAIL=your-email@gmail.com
ALERT_TO_EMAIL=your-email@gmail.com

# --- Database ---
DATABASE_PATH=data/fares.db

# --- Providers ---
# Comma-separated, any combination of:
#   google_flights  - live prices scraped from Google Flights (Playwright)
#   amadeus         - Amadeus Self-Service Flight Offers Search API (needs
#                     AMADEUS_API_KEY/SECRET below - free tier available at
#                     https://developers.amadeus.com)
#   demo            - synthetic sample fares, no network/browser needed at
#                     all; useful for trying out the UI with no setup
# (kiwi was investigated but not shipped - see docs/recon_notes.md)
ENABLED_SITES=google_flights

# Politeness delay range (seconds) applied before each browser-based provider
# is hit.
SCRAPE_DELAY_MIN_SECONDS=1.5
SCRAPE_DELAY_MAX_SECONDS=4.0
# Set to false to watch the browser while debugging a broken adapter.
PLAYWRIGHT_HEADLESS=true

# --- Amadeus API (optional - only used if "amadeus" is in ENABLED_SITES) ---
AMADEUS_API_KEY=
AMADEUS_API_SECRET=
# test.api.amadeus.com (free tier, cached/test data) or api.amadeus.com
# (production access, real-time pricing).
AMADEUS_HOSTNAME=test.api.amadeus.com

# --- Booking links ---
# How many of the cheapest fares from a search get a direct per-flight
# booking link resolved automatically (costs ~8s per fare, Google Flights
# only). Any other result can still request one on demand from the UI. 0-5.
BOOKING_LINK_RESOLVE_COUNT=1

# --- Search result cache ---
# Repeating an identical search within this many seconds reuses the previous
# result instead of re-scraping. Set to 0 to disable.
SEARCH_CACHE_TTL_SECONDS=300

# --- Watch scheduler ---
# How often (in hours) saved watched routes are re-checked in the background.
CHECK_INTERVAL_HOURS=4
