# Copy this file to .env and fill in real values. Never commit .env.

# --- SMTP / email alerts ---
# Example for Gmail: use an "App Password", not your real account password.
# https://support.google.com/accounts/answer/185833
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password-here
ALERT_FROM_EMAIL=your-email@gmail.com
ALERT_TO_EMAIL=your-email@gmail.com

# --- Database ---
DATABASE_PATH=data/fares.db

# --- Scraper behavior ---
# Comma-separated adapter names. Currently supported: google_flights
# (kiwi was investigated but not shipped in v1 - see docs/recon_notes.md)
ENABLED_SITES=google_flights
# Politeness delay range (seconds) applied before each site is hit.
SCRAPE_DELAY_MIN_SECONDS=1.5
SCRAPE_DELAY_MAX_SECONDS=4.0
# Set to false to watch the browser while debugging a broken adapter.
PLAYWRIGHT_HEADLESS=true

# --- Watch scheduler ---
# How often (in hours) saved watched routes are re-checked in the background.
CHECK_INTERVAL_HOURS=4
